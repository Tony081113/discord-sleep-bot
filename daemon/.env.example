# R2 Guardian Daemon dedicated environment file
# Copy to daemon/.env and fill values.

DAEMON_HOST=0.0.0.0
DAEMON_PORT=8091

# Mutual authentication tokens (daemon verifies DB-mod token,
# DB-mod verifies daemon token from response header)
DAEMON_EXPECTED_DBMOD_TOKEN=replace_with_long_random_token_for_dbmod
DAEMON_SELF_TOKEN=replace_with_long_random_token_for_daemon

# Local daemon metadata DB
DAEMON_META_DB_PATH=daemon/daemon_state.db

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=your-r2-bucket-name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Global R2 quota in GB — R2 writes are locked when total usage exceeds this
R2_GLOBAL_QUOTA_GB=10

# Discord developer notification (DM sent when R2 is globally locked)
# DISCORD_BOT_TOKEN should be the same token used by the bot
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_DEV_USER_ID=your_discord_user_id
